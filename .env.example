# Use a dedicated MongoDB database. Never commit real credentials.
MONGODB_URI=
APP_URL=http://localhost:3000
ADMIN_USERNAME=
# Generate with npm run admin:password (reads password from standard input).
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Flutterwave Payment Gateway Credentials
NEXT_PUBLIC_FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
